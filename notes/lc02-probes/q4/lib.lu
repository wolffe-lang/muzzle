//! q4: the integer operations a formatter needs.

/// The magnitude of an i64 as a u64, INT64_MIN included, without overflow.
fn mag(v: i64) -> u64 {
    if v < 0 {
        (0 - (v + 1)) as u64 + 1
    } else {
        v as u64
    }
}

export fn q4_mag(v: i64) -> u64 {
    mag(v)
}

export fn q4_bits(x: u64) -> u64 {
    ((x >> 4) & 15) | (((x as wrapping[u64]) << 8) as u64 ^ 1) | (!x & 255)
}

export fn q4_wrap(x: u64) -> u64 {
    let w = 0 as wrapping[u64]
    (w - x as wrapping[u64]) as u64
}

export fn q4_narrow(x: i32) -> i64 {
    let a = x as wrapping[i8] as i8
    let b = x as wrapping[u16] as u16
    a as i64 * 100000 + b as i64
}
