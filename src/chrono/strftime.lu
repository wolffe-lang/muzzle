//! <time.h> C17 7.27.3.5 strftime in the C locale, with POSIX.1-2024's
//! %s and its field widths, and %z and %Z from tm_gmtoff and tm_zone.
//!
//! What the C locale and glibc's choices give (docs/LEDGER.md):
//!   - %c is "%a %b %e %H:%M:%S %Y", %x is %m/%d/%y, %X is %T, %r is
//!     "%I:%M:%S %p"; names are English, the abbreviations their first
//!     three letters; a field out of its range prints `?` for a name;
//!   - %Y, %G and %C have no minimum width, and a negative year divides
//!     down (%C of year -5 is -1, %y of it 95); %F is %Y-%m-%d;
//!   - a field width (with or without the `0` flag) pads a number with
//!     zeros after its sign, and %F as a whole; %e, %k and %l pad with
//!     spaces unless `0` is given;
//!   - E is accepted before c C x X y Y and O before d e H I m M S u U V
//!     w W y, changing nothing in the C locale (7.27.3.5p6);
//!   - any other specification, a flag other than `0` included (glibc
//!     2.39 has no `+`), is copied to the output as written;
//!   - %Z of a null tm_zone is the local zone's name, UTC; %z is the
//!     offset's sign and its hours and minutes, truncated toward zero;
//!   - %k, %l and %P are glibc's extensions (the 24- and 12-hour clock
//!     space-padded, am/pm).
//! The result counts every byte; when it and its null do not fit maxsize
//! the answer is 0 (7.27.3.5p8).
//!
//! Sources: C17 7.27.3.5; POSIX.1-2024 XSH strftime; strftime(3); ISO
//! 8601 (the week-based year: week 1 holds the year's first Thursday).

/// The C locale's names (sys.S): 7 and 12 pointers to strings.
extern "c" let __muzzle_day_names: *u64

extern "c" let __muzzle_mon_names: *u64

/// The output: bytes go to dst while they leave room for the null; len
/// counts every byte.
struct Out {
    dst: *u8,
    cap: uint,
    len: uint,
}

/// "AM", "PM", "am", "pm" and "UTC", packed low byte first.
const TEXT_AM: u64 = 0x4d41

const TEXT_PM: u64 = 0x4d50

const TEXT_LOWER_AM: u64 = 0x6d61

const TEXT_LOWER_PM: u64 = 0x6d70

const TEXT_UTC: u64 = 0x435455

const WIDTH_CAP: uint = 1000000

fn put(mut o: Out, b: u8) {
    if o.len + 1 < o.cap {
        // # Safety: len + 1 < cap, the size C gave for dst.
        unsafe {
            o.dst[o.len as int] = b
        }
    }
    o.len += 1
}

fn put_n(mut o: Out, b: u8, n: uint) {
    var k: uint = 0
    while k < n {
        put(mut o, b)
        k += 1
    }
}

fn put_packed(mut o: Out, w: u64) {
    var v = w
    while v != 0 {
        put(mut o, (v % 256) as u8)
        v = v / 256
    }
}

/// The string at address p, up to its null or max bytes.
fn put_cstr(mut o: Out, p: u64, max: int) {
    var k: int = 0
    // # Safety: p is a string (a name in sys.S, or C's tm_zone).
    unsafe {
        let q = p as uint as *u8
        while q[k] != 0 && k < max {
            put(mut o, q[k])
            k += 1
        }
    }
}

fn put_name(mut o: Out, table: *u64, n: i32, count: i32, abbrev: bool) {
    if n < 0 || n >= count {
        put(mut o, 63)
        return
    }
    var p: u64 = 0
    // # Safety: n indexes the table's count entries.
    unsafe {
        p = table[n as int]
    }
    put_cstr(mut o, p, if abbrev { 3 } else { 64 })
}

/// v in decimal: at least digits digits, then padded to width with pad
/// ('0' between the sign and the digits, ' ' before the sign).
fn put_num(mut o: Out, v: i64, digits: uint, width: uint, pad: u8) {
    let neg = v < 0
    var mag: u64 = 0
    if neg {
        mag = (0 - (v + 1)) as u64 + 1
    } else {
        mag = v as u64
    }
    var nd: uint = 1
    var t = mag / 10
    while t > 0 {
        nd += 1
        t = t / 10
    }
    let body = if nd > digits { nd } else { digits }
    let total = body + if neg { 1 } else { 0 }
    let fill = if width > total { width - total } else { 0 }
    if pad == 48 {
        if neg {
            put(mut o, 45)
        }
        put_n(mut o, 48, fill + body - nd)
    } else {
        put_n(mut o, 32, fill)
        if neg {
            put(mut o, 45)
        }
        put_n(mut o, 48, body - nd)
    }
    var p: u64 = 1
    var k: uint = 1
    while k < nd {
        p = p * 10
        k += 1
    }
    while p > 0 {
        put(mut o, (48 + mag / p % 10) as u8)
        p = p / 10
    }
}

fn year_of(tm: *Tm) -> i64 {
    var y: i64 = 0
    // # Safety: C's precondition: tm addresses a struct tm.
    unsafe {
        y = tm[0].year as i64 + 1900
    }
    y
}

fn field(tm: *Tm, which: int) -> i64 {
    var v: i32 = 0
    // # Safety: C's precondition: tm addresses a struct tm.
    unsafe {
        if which == 0 {
            v = tm[0].sec
        } else if which == 1 {
            v = tm[0].min
        } else if which == 2 {
            v = tm[0].hour
        } else if which == 3 {
            v = tm[0].mday
        } else if which == 4 {
            v = tm[0].mon
        } else if which == 6 {
            v = tm[0].wday
        } else {
            v = tm[0].yday
        }
    }
    v as i64
}

/// ISO 8601 weeks in year y: 53 when it starts on a Thursday, or on a
/// Wednesday in a leap year.
fn iso_weeks(y: i64) -> i64 {
    let p = floor_mod(y + floor_div(y, 4) - floor_div(y, 100) + floor_div(y, 400), 7)
    let q = floor_mod(y - 1 + floor_div(y - 1, 4) - floor_div(y - 1, 100) + floor_div(y - 1, 400), 7)
    if p == 4 || q == 3 { 53 } else { 52 }
}

/// The ISO week-based year (iso true) or week number (iso false).
fn iso(tm: *Tm, want_year: bool) -> i64 {
    let y = year_of(tm)
    let wd = floor_mod(field(tm, 6) + 6, 7)
    let week = floor_div(field(tm, 7) - wd + 10, 7)
    var iy = y
    var w = week
    if week < 1 {
        iy = y - 1
        w = iso_weeks(iy)
    } else if week > iso_weeks(y) {
        iy = y + 1
        w = 1
    }
    if want_year { iy } else { w }
}

fn numeric(c: u8) -> bool {
    c == 67 || c == 100 || c == 101 || c == 103 || c == 71 || c == 72 || c == 73 || c == 106 || c == 107 || c == 108 || c == 109 || c == 77 || c == 83 || c == 115 || c == 117 || c == 85 || c == 86 || c == 119 || c == 87 || c == 121 || c == 89
}

/// One conversion, c, into o. width and pad apply to a number; a text
/// or composite conversion is padded by spec().
fn conv(mut o: Out, c: u8, tm: *Tm, width: uint, pad: u8) {
    let hour = field(tm, 2)
    if c == 97 || c == 65 {
        put_name(mut o, __muzzle_day_names, field(tm, 6) as wrapping[i32] as i32, 7, c == 97)
    } else if c == 98 || c == 66 || c == 104 {
        put_name(mut o, __muzzle_mon_names, field(tm, 4) as wrapping[i32] as i32, 12, c != 66)
    } else if c == 99 {
        conv(mut o, 97, tm, 0, 48)
        put(mut o, 32)
        conv(mut o, 98, tm, 0, 48)
        put(mut o, 32)
        conv(mut o, 101, tm, 0, 32)
        put(mut o, 32)
        conv(mut o, 84, tm, 0, 48)
        put(mut o, 32)
        conv(mut o, 89, tm, 0, 48)
    } else if c == 67 {
        put_num(mut o, floor_div(year_of(tm), 100), 1, width, pad)
    } else if c == 100 {
        put_num(mut o, field(tm, 3), 2, width, pad)
    } else if c == 68 || c == 120 {
        conv(mut o, 109, tm, 0, 48)
        put(mut o, 47)
        conv(mut o, 100, tm, 0, 48)
        put(mut o, 47)
        conv(mut o, 121, tm, 0, 48)
    } else if c == 101 {
        put_num(mut o, field(tm, 3), 1, if width > 2 { width } else { 2 }, pad)
    } else if c == 70 {
        conv(mut o, 89, tm, 0, 48)
        put(mut o, 45)
        conv(mut o, 109, tm, 0, 48)
        put(mut o, 45)
        conv(mut o, 100, tm, 0, 48)
    } else if c == 103 {
        put_num(mut o, floor_mod(iso(tm, true), 100), 2, width, pad)
    } else if c == 71 {
        put_num(mut o, iso(tm, true), 1, width, pad)
    } else if c == 72 {
        put_num(mut o, hour, 2, width, pad)
    } else if c == 73 {
        put_num(mut o, if floor_mod(hour, 12) == 0 { 12 } else { floor_mod(hour, 12) }, 2, width, pad)
    } else if c == 106 {
        put_num(mut o, field(tm, 7) + 1, 3, width, pad)
    } else if c == 107 {
        put_num(mut o, hour, 1, if width > 2 { width } else { 2 }, pad)
    } else if c == 108 {
        put_num(mut o, if floor_mod(hour, 12) == 0 { 12 } else { floor_mod(hour, 12) }, 1, if width > 2 { width } else { 2 }, pad)
    } else if c == 109 {
        put_num(mut o, field(tm, 4) + 1, 2, width, pad)
    } else if c == 77 {
        put_num(mut o, field(tm, 1), 2, width, pad)
    } else if c == 110 {
        put(mut o, 10)
    } else if c == 112 {
        put_packed(mut o, if hour >= 12 { TEXT_PM } else { TEXT_AM })
    } else if c == 80 {
        put_packed(mut o, if hour >= 12 { TEXT_LOWER_PM } else { TEXT_LOWER_AM })
    } else if c == 114 {
        conv(mut o, 73, tm, 0, 48)
        put(mut o, 58)
        conv(mut o, 77, tm, 0, 48)
        put(mut o, 58)
        conv(mut o, 83, tm, 0, 48)
        put(mut o, 32)
        conv(mut o, 112, tm, 0, 48)
    } else if c == 82 {
        conv(mut o, 72, tm, 0, 48)
        put(mut o, 58)
        conv(mut o, 77, tm, 0, 48)
    } else if c == 83 {
        put_num(mut o, field(tm, 0), 2, width, pad)
    } else if c == 115 {
        put_num(mut o, seconds(tm, true), 1, width, pad)
    } else if c == 116 {
        put(mut o, 9)
    } else if c == 84 || c == 88 {
        conv(mut o, 72, tm, 0, 48)
        put(mut o, 58)
        conv(mut o, 77, tm, 0, 48)
        put(mut o, 58)
        conv(mut o, 83, tm, 0, 48)
    } else if c == 117 {
        let wd = floor_mod(field(tm, 6), 7)
        put_num(mut o, if wd == 0 { 7 } else { wd }, 1, width, pad)
    } else if c == 85 {
        put_num(mut o, floor_div(field(tm, 7) + 7 - field(tm, 6), 7), 2, width, pad)
    } else if c == 86 {
        put_num(mut o, iso(tm, false), 2, width, pad)
    } else if c == 119 {
        put_num(mut o, field(tm, 6), 1, width, pad)
    } else if c == 87 {
        put_num(mut o, floor_div(field(tm, 7) + 7 - floor_mod(field(tm, 6) + 6, 7), 7), 2, width, pad)
    } else if c == 121 {
        put_num(mut o, floor_mod(year_of(tm), 100), 2, width, pad)
    } else if c == 89 {
        put_num(mut o, year_of(tm), 1, width, pad)
    } else if c == 122 {
        var off: i64 = 0
        // # Safety: C's precondition: tm addresses a struct tm.
        unsafe {
            off = tm[0].gmtoff
        }
        put(mut o, if off < 0 { 45 } else { 43 })
        let a = if off < 0 { 0 - off } else { off }
        put_num(mut o, a / 3600, 2, 0, 48)
        put_num(mut o, a % 3600 / 60, 2, 0, 48)
    } else if c == 90 {
        var z: u64 = 0
        // # Safety: C's precondition: tm addresses a struct tm.
        unsafe {
            z = tm[0].zone
        }
        if z == 0 {
            put_packed(mut o, TEXT_UTC)
        } else {
            put_cstr(mut o, z, 4096)
        }
    } else {
        put(mut o, 37)
    }
}

/// A conversion with its field width: a number pads itself (conv); a
/// text or composite one is padded in front to width, with zeros when
/// the `0` flag was given and spaces otherwise.
fn spec(mut o: Out, c: u8, tm: *Tm, width: uint, zero: bool) {
    let dflt: u8 = if c == 101 || c == 107 || c == 108 { 32 } else { 48 }
    let pad: u8 = if zero { 48 } else { dflt }
    if numeric(c) || width == 0 {
        conv(mut o, c, tm, width, pad)
        return
    }
    var probe = Out { dst: o.dst, cap: 0, len: 0 }
    conv(mut probe, c, tm, 0, pad)
    if width > probe.len {
        put_n(mut o, if zero || c == 70 { 48 } else { 32 }, width - probe.len)
    }
    conv(mut o, c, tm, 0, pad)
}

/// True when conversion c takes modifier m (0 for none).
fn takes(c: u8, m: u8) -> bool {
    if m == 69 {
        return c == 99 || c == 67 || c == 120 || c == 88 || c == 121 || c == 89
    }
    if m == 79 {
        return c == 100 || c == 101 || c == 72 || c == 73 || c == 109 || c == 77 || c == 83 || c == 117 || c == 85 || c == 86 || c == 119 || c == 87 || c == 121
    }
    numeric(c) || c == 97 || c == 65 || c == 98 || c == 66 || c == 99 || c == 68 || c == 70 || c == 104 || c == 110 || c == 112 || c == 80 || c == 114 || c == 82 || c == 116 || c == 84 || c == 120 || c == 88 || c == 122 || c == 90 || c == 37
}

/// C17 7.27.3.5: the bytes written, not counting the null, or 0 when
/// they and the null do not fit maxsize.
export fn strftime(s: *u8, maxsize: uint, format: *u8, timeptr: *Tm) -> uint {
    var o = Out { dst: s, cap: maxsize, len: 0 }
    var i: int = 0
    var going = true
    // # Safety: C's precondition: format is a string; each read stops at
    // its null.
    unsafe {
        while going {
            let c = format[i]
            if c == 0 {
                going = false
            } else if c != 37 {
                put(mut o, c)
                i += 1
            } else {
                let start = i
                i += 1
                var zero = false
                var bad = false
                while format[i] == 48 || format[i] == 43 || format[i] == 95 || format[i] == 45 || format[i] == 94 || format[i] == 35 {
                    if format[i] == 48 {
                        zero = true
                    } else {
                        bad = true
                    }
                    i += 1
                }
                var width: uint = 0
                while format[i] >= 48 && format[i] <= 57 {
                    width = width * 10 + (format[i] - 48) as uint
                    if width > WIDTH_CAP {
                        width = WIDTH_CAP
                    }
                    i += 1
                }
                var m: u8 = 0
                if format[i] == 69 || format[i] == 79 {
                    m = format[i]
                    i += 1
                }
                let cv = format[i]
                if cv != 0 {
                    i += 1
                }
                if bad || cv == 0 || !takes(cv, m) {
                    var k = start
                    while k < i {
                        put(mut o, format[k])
                        k += 1
                    }
                } else {
                    spec(mut o, cv, timeptr, width, zero)
                }
            }
        }
    }
    if o.len + 1 > maxsize {
        return 0
    }
    // # Safety: len + 1 <= maxsize: the null fits.
    unsafe {
        s[o.len as int] = 0
    }
    o.len
}
