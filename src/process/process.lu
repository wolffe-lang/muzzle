//! Leaving the process, and the one output path: C17 7.22.4.4 exit,
//! 7.22.4.5 _Exit; POSIX.1-2024 XSH _exit and write.
//!
//! exit writes out every open stream's pending output (C17 7.22.4.4p4),
//! then ends the process; _Exit and _exit do not flush (C17 7.22.4.5p2
//! leaves it to the implementation; muzzle does not, as glibc does not).
//! No atexit handlers yet (C function pointers, wolf-lang#520).

use sys
use stdio

const SYS_WRITE: i64 = 1

/// C17 7.22.4.4: the streams' pending output, then the process's end.
/// The descriptors close with the process.
export fn exit(status: i32) {
    let ok = stdio.flush_all()
    sys.exit_group(status)
}

/// C17 7.22.4.5.
export fn _Exit(status: i32) {
    sys.exit_group(status)
}

/// POSIX.1-2024 XSH _exit.
export fn _exit(status: i32) {
    sys.exit_group(status)
}

/// POSIX.1-2024 XSH write: the bytes written, or -1 with errno set. The
/// kernel checks the buffer (EFAULT) and the descriptor (EBADF).
export fn write(fd: i32, buf: *u8, n: uint) -> i64 {
    var at: i64 = 0
    // # Safety: reads buf's address only; the kernel checks the bytes.
    unsafe {
        at = buf.addr() as wrapping[i64] as i64
    }
    sys.ret(sys.raw(SYS_WRITE, fd as i64, at, n as wrapping[i64] as i64, 0, 0, 0))
}

/// True. The package root calls it so the build reaches this module:
/// a module only C calls into is otherwise never compiled, and an
/// import nothing uses is E0305 (wolf-lang#599).
pub fn linked() -> bool {
    true
}
