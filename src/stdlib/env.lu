//! The environment: C17 7.22.4.6 getenv; POSIX.1-2024 XSH setenv and
//! unsetenv, over XBD 8.1's environ.
//!
//! environ (sys.S) starts as the list _start found on the initial stack
//! (crt0.S). getenv reads whatever environ is now, so a list the program
//! assigns is the one it searches. setenv replaces an entry in place and
//! appends a new one at the end (both as glibc does); appending needs
//! room, so the first append copies the list into one muzzle allocated,
//! and later ones grow that. unsetenv removes every match and closes the
//! gap, keeping the order. A name that is empty or holds `=` is EINVAL
//! for both, as POSIX says; so is a null one (glibc's answer). The
//! strings setenv makes are never freed: a program may still hold one
//! getenv answered.
//!
//! Sources: C17 7.22.4.6; POSIX.1-2024 XBD 8.1, XSH getenv, setenv,
//! unsetenv; environ(7), setenv(3).

use sys
use heap
use string

extern "c" let __muzzle_environ: *u64

const EINVAL: i32 = 22

const ENOMEM: i32 = 12

/// The list setenv allocated (0 for none) and its room in entries.
var env_owned: u64 = 0

var env_room: uint = 0

fn list() -> *u64 {
    var p: u64 = 0
    // # Safety: environ is sys.S's 8-byte object.
    unsafe {
        p = __muzzle_environ[0]
    }
    // # Safety: environ holds a char ** or null.
    unsafe {
        p as uint as *u64
    }
}

fn set_list(p: u64) {
    // # Safety: environ is sys.S's 8-byte object.
    unsafe {
        __muzzle_environ[0] = p
    }
}

fn entry(env: *u64, i: int) -> *u8 {
    // # Safety: i is below the list's length (callers stop at its null).
    unsafe {
        env[i] as uint as *u8
    }
}

fn count(env: *u64) -> int {
    if env.is_null() {
        return 0
    }
    var n: int = 0
    // # Safety: the list ends with a null entry (XBD 8.1).
    unsafe {
        while env[n] != 0 {
            n += 1
        }
    }
    n
}

/// True for an entry `name=...`, name being n bytes.
fn names(e: *u8, name: *u8, n: uint) -> bool {
    // # Safety: e is a string; the comparison stops at the first
    // difference, which a shorter e's null is.
    unsafe {
        string.strncmp(e, name, n) == 0 && e[n as int] == 61
    }
}

/// The index of the first entry for name, or -1.
fn find(env: *u64, name: *u8, n: uint) -> int {
    let c = count(env)
    var i: int = 0
    while i < c {
        if names(entry(env, i), name, n) {
            return i
        }
        i += 1
    }
    -1
}

/// True for a name setenv and unsetenv accept.
fn valid(name: *u8) -> bool {
    if name.is_null() {
        return false
    }
    // # Safety: name is a string.
    unsafe {
        name[0] != 0 && string.strchr(name, 61).is_null()
    }
}

/// C17 7.22.4.6: the value of name, or a null pointer.
export fn getenv(name: *u8) -> *u8 {
    let env = list()
    var at: int = -1
    var n: uint = 0
    if !name.is_null() && !env.is_null() {
        n = string.strlen(name)
        if n > 0 {
            at = find(env, name, n)
        }
    }
    if at < 0 {
        // # Safety: the null pointer.
        unsafe {
            return 0 as *u8
        }
    }
    // # Safety: the entry is `name=value`; its value starts n + 1 bytes in.
    unsafe {
        (entry(env, at).addr() + n + 1) as *u8
    }
}

/// XSH setenv: name=value, replacing an entry only when overwrite is
/// nonzero. 0, or -1 with errno EINVAL or ENOMEM.
export fn setenv(name: *u8, value: *u8, overwrite: i32) -> i32 {
    if !valid(name) {
        sys.set_errno(EINVAL)
        return -1
    }
    let env = list()
    let n = string.strlen(name)
    let at = find(env, name, n)
    if at >= 0 && overwrite == 0 {
        return 0
    }
    let v = string.strlen(value)
    let s = heap.malloc(n + v + 2)
    if s.is_null() {
        return -1
    }
    let a = string.memcpy(s, name, n)
    // # Safety: s holds n + v + 2 bytes.
    unsafe {
        s[n as int] = 61
        let b = string.memcpy((s.addr() + n + 1) as *u8, value, v)
        s[(n + v + 1) as int] = 0
    }
    if at >= 0 {
        // # Safety: at is an entry of the list.
        unsafe {
            env[at] = s.addr() as u64
        }
        return 0
    }
    let c = count(env)
    var owned: u64 = 0
    var room: uint = 0
    // # Safety: one thread; scalars.
    unsafe {
        owned = env_owned
        room = env_room
    }
    var dst = env
    if env.is_null() || env.addr() as u64 != owned || room < c as uint + 2 {
        let want = (c as uint + 2) * 2 + 16
        let fresh = heap.malloc(want * 8)
        if fresh.is_null() {
            heap.free(s)
            sys.set_errno(ENOMEM)
            return -1
        }
        if c > 0 {
            // # Safety: env holds c entries of 8 bytes.
            unsafe {
                let d = string.memcpy(fresh, env.addr() as *u8, c as uint * 8)
            }
        }
        if owned != 0 && env.addr() as u64 == owned {
            // # Safety: owned is the block an earlier setenv allocated.
            unsafe {
                heap.free(owned as uint as *u8)
            }
        }
        // # Safety: fresh holds want 8-byte entries.
        unsafe {
            dst = fresh.addr() as *u64
            env_owned = fresh.addr() as u64
            env_room = want
        }
        set_list(dst.addr() as u64)
    }
    // # Safety: dst has room for c + 2 entries.
    unsafe {
        dst[c] = s.addr() as u64
        dst[c + 1] = 0
    }
    0
}

/// XSH unsetenv: removes every entry for name. 0, or -1 with EINVAL.
export fn unsetenv(name: *u8) -> i32 {
    if !valid(name) {
        sys.set_errno(EINVAL)
        return -1
    }
    let env = list()
    if env.is_null() {
        return 0
    }
    let n = string.strlen(name)
    let c = count(env)
    var i: int = 0
    var j: int = 0
    // # Safety: i and j stay below c, the list's length; the null at c
    // is moved down after the kept entries.
    unsafe {
        while i < c {
            if !names(entry(env, i), name, n) {
                env[j] = env[i]
                j += 1
            }
            i += 1
        }
        env[j] = 0
    }
    0
}
