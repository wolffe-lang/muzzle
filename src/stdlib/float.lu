//! <stdlib.h> C17 7.22.1.3 strtod, in integers.
//!
//! wolf has no floating point type on the freestanding target (K10), so
//! the conversion answers the double's IEEE 754 binary64 bits, and
//! sys.S's `strtod` moves them to %xmm0. The result is correctly rounded
//! (C17 7.22.1.3p9 and F.5: to nearest, ties to even) for any length of
//! input:
//!   - decimal: the significant digits D (the first 800; any nonzero
//!     digit past them only sets a sticky bit, which cannot move a
//!     double's rounding: 800 digits pin the value far below the
//!     rounding point) and a decimal exponent E. D * 10^E is formed
//!     exactly in big integers, or D * 2^s / 10^-E is divided out to a
//!     57-bit quotient and a remainder;
//!   - hexadecimal: the first 15 significant hex digits and a binary
//!     exponent, exact; later nonzero digits set the sticky bit.
//! Both end in one rounding to 53 bits, or to the subnormal grid below
//! 2^-1022. ERANGE marks an overflow (an infinity) and an underflow: a
//! value below 2^-1022 whose result is inexact, even when it rounds up to
//! 2^-1022 itself (glibc's choice of tininess before rounding; C17
//! 7.22.1.3p10 leaves it to the implementation). INF, INFINITY, NAN and
//! NAN(n-char-sequence) are read without regard to case; a NaN's
//! sequence, when it is a number strtoull would read in base 0, becomes
//! its payload (glibc's answer; implementation-defined in C17).
//!
//! Big integers are little-endian 32-bit limbs in sys.S's
//! __muzzle_limbs (three regions of 160), worked in u64 arithmetic: a
//! limb times a factor below 2^30 plus a carry stays below 2^63.
//!
//! Sources: C17 7.22.1.3 and Annex F.5, IEEE 754-2019 (binary64's
//! fields, round to nearest even, subnormals), strtod(3). The method
//! (exact big-integer scaling, one rounding) is the textbook one; no
//! library's code was read.

use sys

/// The three big-integer regions, 160 limbs each (sys.S, 1920 bytes).
extern "c" let __muzzle_limbs: *u32

const ERANGE: i32 = 34

const RA: int = 0

const RB: int = 160

const RC: int = 320

const BASE32: u64 = 0x1_0000_0000

const BILLION: u64 = 1000000000

/// Significant decimal digits kept exactly.
const MAXDIG: int = 800

/// Exponents saturate here: any larger one is already an infinity or a
/// zero.
const EXP_CAP: i64 = 100000000

const HIDDEN: u64 = 0x10_0000_0000_0000

const INF: u64 = 0x7ff0_0000_0000_0000

const QNAN: u64 = 0x7ff8_0000_0000_0000

const PAYLOAD: u64 = 0x7_ffff_ffff_ffff

const SIGN: u64 = 0x8000_0000_0000_0000

/// A conversion's answer: the bits, the index just past what it read (0
/// for no conversion), and whether it is a range error.
struct Conv {
    bits: u64,
    used: int,
    erange: bool,
}

/// A rounding's answer.
struct Rounded {
    bits: u64,
    erange: bool,
}

fn limb(i: int) -> u64 {
    var v: u64 = 0
    // # Safety: i stays inside the 480 limbs of __muzzle_limbs: each
    // region's numbers stay under 160 limbs (D below 2^2658, 10^1123
    // below 2^3731, and either shifted by at most 57 + 56 bits more).
    unsafe {
        v = __muzzle_limbs[i] as u64
    }
    v
}

fn set_limb(i: int, v: u64) {
    // # Safety: as limb(); v is below 2^32 at every call.
    unsafe {
        __muzzle_limbs[i] = v as u32
    }
}

/// a = a * m + add (m and add below 2^30); the new length.
fn big_mul_add(a: int, n: int, m: u64, add: u64) -> int {
    var carry = add
    var i: int = 0
    while i < n {
        let x = limb(a + i) * m + carry
        set_limb(a + i, x % BASE32)
        carry = x / BASE32
        i += 1
    }
    var len = n
    while carry != 0 {
        set_limb(a + len, carry % BASE32)
        carry = carry / BASE32
        len += 1
    }
    len
}

fn big_bitlen(a: int, n: int) -> int {
    if n == 0 {
        return 0
    }
    var top = limb(a + n - 1)
    var b: int = 0
    while top != 0 {
        top = top / 2
        b += 1
    }
    (n - 1) * 32 + b
}

/// a = a << k; the new length. a's top limb is nonzero.
fn big_shl(a: int, n: int, k: int) -> int {
    if n == 0 {
        return 0
    }
    let ls = k / 32
    let bs = (k % 32) as u64
    var len = n + ls
    if bs > 0 {
        let spill = limb(a + n - 1) >> (32 - bs)
        if spill != 0 {
            set_limb(a + n + ls, spill)
            len += 1
        }
    }
    var i = n - 1
    while i >= 0 {
        var v = (limb(a + i) << bs) % BASE32
        if bs > 0 && i > 0 {
            v = v + (limb(a + i - 1) >> (32 - bs))
        }
        set_limb(a + i + ls, v)
        i -= 1
    }
    var z: int = 0
    while z < ls {
        set_limb(a + z, 0)
        z += 1
    }
    len
}

/// a = a >> 1; the new length.
fn big_shr1(a: int, n: int) -> int {
    var i: int = 0
    while i < n {
        var v = limb(a + i) / 2
        if i + 1 < n {
            v = v + (limb(a + i + 1) % 2) * 2147483648
        }
        set_limb(a + i, v)
        i += 1
    }
    if n > 0 && limb(a + n - 1) == 0 {
        return n - 1
    }
    n
}

/// The sign of a - b, both normalized (top limb nonzero).
fn big_cmp(a: int, na: int, b: int, nb: int) -> int {
    if na != nb {
        return if na > nb { 1 } else { -1 }
    }
    var i = na - 1
    while i >= 0 {
        let x = limb(a + i)
        let y = limb(b + i)
        if x != y {
            return if x > y { 1 } else { -1 }
        }
        i -= 1
    }
    0
}

/// a = a - b, for a >= b; the new length.
fn big_sub(a: int, na: int, b: int, nb: int) -> int {
    var borrow: u64 = 0
    var i: int = 0
    while i < na {
        let y = if i < nb { limb(b + i) } else { 0 }
        let x = limb(a + i) + BASE32 - y - borrow
        set_limb(a + i, x % BASE32)
        borrow = if x < BASE32 { 1 } else { 0 }
        i += 1
    }
    var len = na
    while len > 0 && limb(a + len - 1) == 0 {
        len -= 1
    }
    len
}

fn big_copy(from: int, to: int, n: int) {
    var i: int = 0
    while i < n {
        set_limb(to + i, limb(from + i))
        i += 1
    }
}

/// True when any of a's lowest k bits is set.
fn big_low_nonzero(a: int, k: int) -> bool {
    var i: int = 0
    while i < k / 32 {
        if limb(a + i) != 0 {
            return true
        }
        i += 1
    }
    let r = (k % 32) as u64
    r > 0 && limb(a + k / 32) % (1 << r) != 0
}

/// The count bits of a just below bit len (its bit length), as an
/// integer.
fn big_top(a: int, len: int, count: int) -> u64 {
    var q: u64 = 0
    var idx = len - 1
    while idx >= len - count {
        let bit = (limb(a + idx / 32) >> ((idx % 32) as u64)) % 2
        q = q * 2 + bit
        idx -= 1
    }
    q
}

fn pow10(k: int) -> u64 {
    var p: u64 = 1
    var i: int = 0
    while i < k {
        p = p * 10
        i += 1
    }
    p
}

/// The double nearest q * 2^-s (q > 0), with sticky saying the true
/// value lies a little above q * 2^-s.
fn round(q: u64, s: i64, sticky: bool) -> Rounded {
    var len: i64 = 0
    var t = q
    while t != 0 {
        t = t / 2
        len += 1
    }
    var e = len - 1 - s
    if e > 1023 {
        return Rounded { bits: INF, erange: true }
    }
    var mant: u64 = 0
    var rb: u64 = 0
    var rest = sticky
    if e >= -1022 {
        let shift = len - 53
        if shift > 0 {
            let sh = shift as u64
            mant = q >> sh
            rb = (q >> (sh - 1)) % 2
            if q % (1 << (sh - 1)) != 0 {
                rest = true
            }
        } else {
            mant = q << ((0 - shift) as u64)
        }
        if rb == 1 && (rest || mant % 2 == 1) {
            mant += 1
            if mant == 2 * HIDDEN {
                mant = HIDDEN
                e += 1
                if e > 1023 {
                    return Rounded { bits: INF, erange: true }
                }
            }
        }
        return Rounded { bits: (e + 1023) as u64 << 52 | (mant - HIDDEN), erange: false }
    }
    // Below 2^-1022: the subnormal grid, steps of 2^-1074.
    let shift = s - 1074
    if shift <= 0 {
        mant = q << ((0 - shift) as u64)
    } else if shift > 64 {
        rest = true
    } else {
        let sh = shift as u64
        mant = q >> sh
        rb = (q >> (sh - 1)) % 2
        if q % (1 << (sh - 1)) != 0 {
            rest = true
        }
    }
    let inexact = rb == 1 || rest
    if rb == 1 && (rest || mant % 2 == 1) {
        mant += 1
    }
    Rounded { bits: mant, erange: inexact }
}

fn is_digit(c: u8) -> bool {
    c >= 48 && c <= 57
}

fn lower(c: u8) -> u8 {
    if c >= 65 && c <= 90 {
        c + 32
    } else {
        c
    }
}

/// An n-char of NAN(n-char-sequence): a digit, a letter or `_`.
fn is_nchar(c: u8) -> bool {
    is_digit(c) || (lower(c) >= 97 && lower(c) <= 122) || c == 95
}

/// Reads an exponent's digits after `e` or `p` at s[i]: its value (with
/// its sign, saturated) and the index past it, or i itself when no digit
/// follows the optional sign.
fn exponent(s: *u8, i: int) -> Conv {
    var j = i + 1
    var neg = false
    var v: i64 = 0
    // # Safety: s is C's string; every test stops at its null.
    unsafe {
        if s[j] == 45 {
            neg = true
            j += 1
        } else if s[j] == 43 {
            j += 1
        }
        if !is_digit(s[j]) {
            return Conv { bits: 0, used: i, erange: false }
        }
        while is_digit(s[j]) {
            if v < EXP_CAP {
                v = v * 10 + (s[j] - 48) as i64
            }
            j += 1
        }
    }
    let signed = if neg { 0 - v } else { v }
    Conv { bits: signed as wrapping[u64] as u64, used: j, erange: false }
}

/// The decimal form from s[i], which is a digit or a point before one.
fn decimal(s: *u8, i0: int) -> Conv {
    var i = i0
    var n: int = 0
    var nd: int = 0
    var chunk: u64 = 0
    var chunk_len: int = 0
    var dexp: i64 = 0
    var sticky = false
    var nonzero = false
    // # Safety: s is C's string; every test stops at its null.
    unsafe {
        while is_digit(s[i]) {
            let d = (s[i] - 48) as u64
            if nonzero || d != 0 {
                nonzero = true
                if nd < MAXDIG {
                    chunk = chunk * 10 + d
                    chunk_len += 1
                    nd += 1
                    if chunk_len == 9 {
                        n = big_mul_add(RA, n, BILLION, chunk)
                        chunk = 0
                        chunk_len = 0
                    }
                } else {
                    dexp += 1
                    if d != 0 {
                        sticky = true
                    }
                }
            }
            i += 1
        }
        if s[i] == 46 {
            i += 1
            while is_digit(s[i]) {
                let d = (s[i] - 48) as u64
                if nonzero || d != 0 {
                    nonzero = true
                    if nd < MAXDIG {
                        chunk = chunk * 10 + d
                        chunk_len += 1
                        nd += 1
                        dexp -= 1
                        if chunk_len == 9 {
                            n = big_mul_add(RA, n, BILLION, chunk)
                            chunk = 0
                            chunk_len = 0
                        }
                    } else if d != 0 {
                        sticky = true
                    }
                } else {
                    dexp -= 1
                }
                i += 1
            }
        }
    }
    n = big_mul_add(RA, n, pow10(chunk_len), chunk)
    var ex: i64 = 0
    var at = i
    // # Safety: s is C's string; s[i] is at or before its null.
    unsafe {
        if s[i] == 101 || s[i] == 69 {
            let x = exponent(s, i)
            at = x.used
            ex = x.bits as wrapping[i64] as i64
        }
    }
    if !nonzero {
        return Conv { bits: 0, used: at, erange: false }
    }
    let e10 = dexp + ex
    let mag = nd as i64 + e10
    if mag > 310 {
        return Conv { bits: INF, used: at, erange: true }
    }
    if mag < -323 {
        return Conv { bits: 0, used: at, erange: true }
    }
    var r = Rounded { bits: 0, erange: false }
    if e10 >= 0 {
        var k = e10
        while k >= 9 {
            n = big_mul_add(RA, n, BILLION, 0)
            k -= 9
        }
        n = big_mul_add(RA, n, pow10(k as int), 0)
        let len = big_bitlen(RA, n)
        if len <= 64 {
            r = round(big_top(RA, len, len), 0, sticky)
        } else {
            let low = big_low_nonzero(RA, len - 56)
            r = round(big_top(RA, len, 56), (56 - len) as i64, sticky || low)
        }
    } else {
        set_limb(RB, 1)
        var nb: int = 1
        var k = 0 - e10
        while k >= 9 {
            nb = big_mul_add(RB, nb, BILLION, 0)
            k -= 9
        }
        nb = big_mul_add(RB, nb, pow10(k as int), 0)
        let sh = 56 + big_bitlen(RB, nb) - big_bitlen(RA, n)
        if sh >= 0 {
            n = big_shl(RA, n, sh)
        } else {
            nb = big_shl(RB, nb, 0 - sh)
        }
        big_copy(RB, RC, nb)
        var nc = big_shl(RC, nb, 57)
        var q: u64 = 0
        var bit: int = 57
        while bit >= 0 {
            q = q * 2
            if big_cmp(RA, n, RC, nc) >= 0 {
                n = big_sub(RA, n, RC, nc)
                q += 1
            }
            nc = big_shr1(RC, nc)
            bit -= 1
        }
        r = round(q, sh as i64, sticky || n != 0)
    }
    Conv { bits: r.bits, used: at, erange: r.erange }
}

/// The hexadecimal form from s[i], just past `0x`, where a hex digit or a
/// point before one stands.
fn hexadecimal(s: *u8, i0: int) -> Conv {
    var i = i0
    var m: u64 = 0
    var kept: int = 0
    var bexp: i64 = 0
    var sticky = false
    var nonzero = false
    // # Safety: s is C's string; every test stops at its null.
    unsafe {
        while digit(s[i]) < 16 {
            let d = digit(s[i])
            if nonzero || d != 0 {
                nonzero = true
                if kept < 15 {
                    m = m * 16 + d
                    kept += 1
                } else {
                    bexp += 4
                    if d != 0 {
                        sticky = true
                    }
                }
            }
            i += 1
        }
        if s[i] == 46 {
            i += 1
            while digit(s[i]) < 16 {
                let d = digit(s[i])
                if nonzero || d != 0 {
                    nonzero = true
                    if kept < 15 {
                        m = m * 16 + d
                        kept += 1
                        bexp -= 4
                    } else if d != 0 {
                        sticky = true
                    }
                } else {
                    bexp -= 4
                }
                i += 1
            }
        }
    }
    var at = i
    var pexp: i64 = 0
    // # Safety: s[i] is at or before the string's null.
    unsafe {
        if s[i] == 112 || s[i] == 80 {
            let x = exponent(s, i)
            at = x.used
            pexp = x.bits as wrapping[i64] as i64
        }
    }
    if !nonzero {
        return Conv { bits: 0, used: at, erange: false }
    }
    let r = round(m, 0 - (bexp + pexp), sticky)
    Conv { bits: r.bits, used: at, erange: r.erange }
}

/// strtod's conversion (sys.S's `strtod` is its C entry): the bits of the
/// double nptr spells, the end pointer stored when endptr is not null.
export fn __muzzle_strtod(nptr: *u8, endptr: *u64) -> u64 {
    var i: int = 0
    var neg = false
    var c = Conv { bits: 0, used: 0, erange: false }
    // # Safety: C's precondition: nptr is a string; each test reads a
    // byte only when every byte before it matched, so none reads past
    // the null.
    unsafe {
        while is_space(nptr[i]) {
            i += 1
        }
        if nptr[i] == 45 {
            neg = true
            i += 1
        } else if nptr[i] == 43 {
            i += 1
        }
        if lower(nptr[i]) == 105 && lower(nptr[i + 1]) == 110 && lower(nptr[i + 2]) == 102 {
            c = Conv { bits: INF, used: i + 3, erange: false }
            if lower(nptr[i + 3]) == 105 && lower(nptr[i + 4]) == 110 && lower(nptr[i + 5]) == 105 && lower(nptr[i + 6]) == 116 && lower(nptr[i + 7]) == 121 {
                c.used = i + 8
            }
        } else if lower(nptr[i]) == 110 && lower(nptr[i + 1]) == 97 && lower(nptr[i + 2]) == 110 {
            c = Conv { bits: QNAN, used: i + 3, erange: false }
            if nptr[i + 3] == 40 {
                var j = i + 4
                while is_nchar(nptr[j]) {
                    j += 1
                }
                if nptr[j] == 41 {
                    c.used = j + 1
                    let seq = (nptr.addr() + (i + 4) as uint) as *u8
                    c.bits = QNAN | payload(seq, nptr.addr() + j as uint) & PAYLOAD
                }
            }
        } else if nptr[i] == 48 && (nptr[i + 1] == 120 || nptr[i + 1] == 88) && (digit(nptr[i + 2]) < 16 || (nptr[i + 2] == 46 && digit(nptr[i + 3]) < 16)) {
            c = hexadecimal(nptr, i + 2)
        } else if is_digit(nptr[i]) || (nptr[i] == 46 && is_digit(nptr[i + 1])) {
            c = decimal(nptr, i)
        }
    }
    if c.erange {
        sys.set_errno(ERANGE)
    }
    if !endptr.is_null() {
        // # Safety: C's precondition: a non-null endptr addresses a char *.
        unsafe {
            endptr[0] = nptr.addr() as u64 + c.used as u64
        }
    }
    if c.used == 0 {
        return 0
    }
    if neg {
        c.bits | SIGN
    } else {
        c.bits
    }
}
