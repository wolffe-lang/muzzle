#!/usr/bin/env bash
# Build muzzle on one compiling tier into build/<tier>/:
#   libmuzzle.a  the wolf object and sys.S's object
#   crt0.o       _start, linked first by the C program
# then gate the archive: every export is defined, and the wolf object
# imports nothing but sys.S's symbols and the trap hook.
#   tools/build native|release
set -euo pipefail
tier=${1:?usage: tools/build native|release}
root=$(cd "$(dirname "$0")/.." && pwd)
W=${WOLF:-$(ls "$root"/.wolf-bin/wolf-*/wolf 2>/dev/null | head -1)}
[ -x "$W" ] || { echo "build: no wolf driver (run tools/fetch-toolchain, or set WOLF)" >&2; exit 2; }
case $tier in native) fl=();; release) fl=(--release);; *) echo "build: tier '$tier'" >&2; exit 2;; esac
out="$root/build/$tier"
rm -rf "$out"; mkdir -p "$out"
cd "$root/src"
"$W" build muzzle.lu --target x86_64-unknown-none --emit=obj --deny-warnings "${fl[@]}" -o "$out/muzzle.o"
clang -c crt0.S -o "$out/crt0.o"
objs=("$out"/muzzle.*.o)
ar rcs "$out/libmuzzle.a" "${objs[@]}"

# The gate. EXPORTS is the C surface this layer promises; every one
# must be defined. The archive must be self-contained: every symbol any
# of its objects leaves undefined is defined by another of them (no
# runtime, no libc, no compiler-emitted import such as wolf-lang#522's
# memcpy from outside). Both checks fail loudly on an empty object set.
EXPORTS="memcpy memmove memset memcmp strlen strcmp strncmp strchr strcpy
malloc free calloc realloc exit _Exit _exit write __errno_location wolf_trap"
fail=0
[ ${#objs[@]} -ge 2 ] || { echo "build: $tier: expected wolf's objects and sys.S's, found ${#objs[@]}" >&2; exit 1; }
defined=$(nm --defined-only -g -j "${objs[@]}" | grep -v ':$' | grep -v '^$' | sort -u)
undef=$(nm -u -j "${objs[@]}" | grep -v ':$' | grep -v '^$' | sort -u)
[ -n "$defined" ] || { echo "build: $tier: no defined symbols at all" >&2; exit 1; }
for e in $EXPORTS; do
  grep -qx "$e" <<<"$defined" || { echo "build: $tier: export '$e' is not defined" >&2; fail=1; }
done
unresolved=$(comm -23 <(printf '%s\n' "$undef" | grep -v '^$') <(printf '%s\n' "$defined"))
if [ -n "$unresolved" ]; then
  echo "build: $tier: the archive imports:" $unresolved >&2
  fail=1
fi
[ "$fail" = 0 ] || exit 1
echo "build: $tier: ${#objs[@]} objects, $(wc -w <<<"$EXPORTS") exports defined, $(wc -l <<<"$undef") internal references, 0 imports -> $out/libmuzzle.a"
