#!/usr/bin/env bash
# The differential (lc00's method, pure mode): every case in
# tests/cases/ is compiled twice, against the host glibc (the reference,
# a black box) and statically against muzzle alone, and run. Compared,
# byte for byte: stdout, stderr, the exit status, and every file the
# case wrote (each column runs in a fresh directory of its own, and the
# two directories must hold the same names with the same bytes).
#
# A case reads its stdin from tests/cases/<name>.in when that file
# exists, else from /dev/null. A case whose source has the line
# `// difftest: tty` runs with its stdout on a pseudo-terminal
# (tests/lib/ptyrun.c, built against the host libc), so the terminal's
# side of stdio (line buffering, isatty) is compared too.
#
# Then every case in tests/own/ runs against muzzle alone: behaviour a
# ruling makes muzzle's own, where glibc is not the oracle (R-lc02-1:
# the floating conversions refused). Each checks itself and must exit 0.
#
# Exits 1 on any disagreement, on a case that fails to build in either
# column, on an own case that fails, and when no case ran.
#   tools/difftest native|release [case.c ...]
set -uo pipefail
tier=${1:?usage: tools/difftest native|release [case.c ...]}; shift
root=$(cd "$(dirname "$0")/.." && pwd)
lib="$root/build/$tier"
out="$root/out/$tier"
rm -rf "$out"; mkdir -p "$out"
cases=("$@"); own=()
if [ ${#cases[@]} -eq 0 ]; then
  cases=("$root"/tests/cases/*.c)
  for o in "$root"/tests/own/*.c; do [ -e "$o" ] && own+=("$o"); done
fi
CFLAGS=(-std=c17 -O1 -Wall -Werror -fno-builtin -fno-stack-protector -I "$root/tests/lib")
MUZZLE=(-nostdinc -isystem "$root/include" -nostdlib -static)
echo "difftest: tier=$tier glibc=$(getconf GNU_LIBC_VERSION 2>/dev/null) $(clang --version | head -1)"
ptyrun="$out/ptyrun"
if ! clang -std=c17 -O1 -Wall -Werror "$root/tests/lib/ptyrun.c" -o "$ptyrun" 2>"$out/ptyrun.cc"; then
  echo "difftest: tests/lib/ptyrun.c does not build"; cat "$out/ptyrun.cc"; exit 1
fi
# run COLUMN NAME BINARY TTY STDIN: runs BINARY in out/<tier>/NAME.COLUMN.d/,
# its stdout, stderr and status beside that directory.
run() {
  local col=$1 n=$2 bin=$3 tty=$4 in=$5 d="$out/$2.$1.d"
  mkdir -p "$d"
  if [ "$tty" = 1 ]; then
    (cd "$d" && exec timeout 60 "$ptyrun" "$bin") <"$in" >"$out/$n.$col.out" 2>"$out/$n.$col.err"
  else
    (cd "$d" && exec timeout 60 "$bin") <"$in" >"$out/$n.$col.out" 2>"$out/$n.$col.err"
  fi
}
pass=0; fail=0
for c in "${cases[@]}"; do
  n=$(basename "$c" .c)
  ok=1
  tty=0; grep -q '^// difftest: tty$' "$c" && tty=1
  in=/dev/null; [ -f "${c%.c}.in" ] && in="${c%.c}.in"
  clang "${CFLAGS[@]}" "$c" -o "$out/$n.glibc" 2>"$out/$n.glibc.cc" || { echo "FAIL $n: glibc column does not build"; cat "$out/$n.glibc.cc"; ok=0; }
  clang "${CFLAGS[@]}" "${MUZZLE[@]}" "$lib/crt0.o" "$c" "$lib/libmuzzle.a" -o "$out/$n.muzzle" 2>"$out/$n.muzzle.cc" \
    || { echo "FAIL $n: muzzle column does not build"; cat "$out/$n.muzzle.cc"; ok=0; }
  if [ $ok = 1 ] && readelf -lW "$out/$n.muzzle" | grep -q INTERP; then
    echo "FAIL $n: the muzzle binary has an interpreter (not pure)"; ok=0
  fi
  if [ $ok = 1 ]; then
    run glibc "$n" "$out/$n.glibc" $tty "$in"; rg=$?
    run muzzle "$n" "$out/$n.muzzle" $tty "$in"; rm_=$?
    if [ ! -s "$out/$n.glibc.out" ]; then
      echo "FAIL $n: the reference printed nothing"; ok=0
    elif [ $rg != $rm_ ]; then
      echo "FAIL $n: exit glibc=$rg muzzle=$rm_"; ok=0
    fi
    if ! cmp -s "$out/$n.glibc.out" "$out/$n.muzzle.out"; then
      echo "FAIL $n: stdout differs"; ok=0
      diff -u --label "$n stdout (glibc)" --label "$n stdout (muzzle $tier)" "$out/$n.glibc.out" "$out/$n.muzzle.out" | head -20
    fi
    if ! cmp -s "$out/$n.glibc.err" "$out/$n.muzzle.err"; then
      echo "FAIL $n: stderr differs"; ok=0
      diff -u --label "$n stderr (glibc)" --label "$n stderr (muzzle $tier)" "$out/$n.glibc.err" "$out/$n.muzzle.err" | head -20
    fi
    if ! diff -r "$out/$n.glibc.d" "$out/$n.muzzle.d" >"$out/$n.files.diff" 2>&1; then
      echo "FAIL $n: the files it wrote differ"; ok=0
      head -20 "$out/$n.files.diff"
    fi
  fi
  if [ $ok = 1 ]; then
    files=$(cd "$out/$n.glibc.d" && find . -type f | wc -l)
    echo "PASS $n exit=$rg lines=$(wc -l <"$out/$n.glibc.out") stderr=$(wc -c <"$out/$n.glibc.err") files=$files$([ $tty = 1 ] && echo ' tty')"
    pass=$((pass+1))
  else
    fail=$((fail+1))
  fi
done
for c in ${own[@]+"${own[@]}"}; do
  n=own-$(basename "$c" .c)
  if ! clang "${CFLAGS[@]}" "${MUZZLE[@]}" "$lib/crt0.o" "$c" "$lib/libmuzzle.a" -o "$out/$n" 2>"$out/$n.cc"; then
    echo "FAIL $n: does not build against muzzle"; cat "$out/$n.cc"; fail=$((fail+1)); continue
  fi
  mkdir -p "$out/$n.d"
  (cd "$out/$n.d" && exec timeout 60 "$out/$n") </dev/null >"$out/$n.out" 2>"$out/$n.err"; r=$?
  if [ $r = 0 ]; then
    echo "PASS $n checks=$(grep -c '^ok ' "$out/$n.out")"; pass=$((pass+1))
  else
    echo "FAIL $n: exit $r"; grep -v '^ok ' "$out/$n.out" | head -20; fail=$((fail+1))
  fi
done
echo "difftest: tier=$tier pass=$pass fail=$fail"
[ $((pass+fail)) -gt 0 ] || { echo "difftest: no case ran" >&2; exit 1; }
[ $fail = 0 ]
